# Host-local tmux overrides for the headless dev container.
# Sourced by the repo .tmux.conf through its ~/.tmux.conf.local hook.

# No X server here, so the xclip copy binding in the shared config cannot work.
# OSC52 hands the selection to the terminal on the other end of the ssh session
# instead, which puts it on the local machine's clipboard.
set -g set-clipboard on
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel
